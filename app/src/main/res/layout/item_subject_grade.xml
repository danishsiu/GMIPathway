<?xml version="1.0" encoding="utf-8"?>
<!-- Rows share these ids and are rebuilt from saved data, so automatic state saving is off. -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/spacing_small">

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/subject_layout"
        style="@style/Widget.GMIPathway.Dropdown"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:hint="@string/eligibility_subject_hint"
        android:saveEnabled="false"
        app:layout_constraintEnd_toStartOf="@id/grade_layout"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <com.google.android.material.textfield.MaterialAutoCompleteTextView
            android:id="@+id/subject_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="none"
            android:saveEnabled="false" />

    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/grade_layout"
        style="@style/Widget.GMIPathway.Dropdown"
        android:layout_width="@dimen/grade_field_width"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/spacing_small"
        android:hint="@string/eligibility_grade_hint"
        android:saveEnabled="false"
        app:layout_constraintEnd_toStartOf="@id/button_remove"
        app:layout_constraintStart_toEndOf="@id/subject_layout"
        app:layout_constraintTop_toTopOf="parent">

        <com.google.android.material.textfield.MaterialAutoCompleteTextView
            android:id="@+id/grade_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="none"
            android:saveEnabled="false" />

    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/button_remove"
        style="@style/Widget.Material3.Button.IconButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:contentDescription="@string/eligibility_remove_subject"
        app:icon="@drawable/ic_close"
        app:layout_constraintBottom_toBottomOf="@id/grade_layout"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/grade_layout"
        app:layout_constraintTop_toTopOf="@id/grade_layout" />

</androidx.constraintlayout.widget.ConstraintLayout>
