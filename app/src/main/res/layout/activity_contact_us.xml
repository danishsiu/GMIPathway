<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".ui.enquiry.ContactUsActivity">

    <include layout="@layout/view_app_bar" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/contact_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/screen_padding">

            <!-- The location card stands in for an embedded map, which would need an API key. -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.GMIPathway.Card.Standard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingTop="@dimen/spacing_small">

                    <include
                        android:id="@+id/row_address"
                        layout="@layout/view_info_row" />

                    <Button
                        android:id="@+id/button_map"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_margin="@dimen/spacing_small_plus"
                        android:text="@string/contact_map_button"
                        app:icon="@drawable/ic_map"
                        app:iconGravity="textStart" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.GMIPathway.Card.Standard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_small_plus">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingVertical="@dimen/spacing_small">

                    <include
                        android:id="@+id/row_phone"
                        layout="@layout/view_info_row" />

                    <include
                        android:id="@+id/row_admissions"
                        layout="@layout/view_info_row" />

                    <include
                        android:id="@+id/row_fax"
                        layout="@layout/view_info_row" />

                    <include
                        android:id="@+id/row_email"
                        layout="@layout/view_info_row" />

                    <include
                        android:id="@+id/row_whatsapp"
                        layout="@layout/view_info_row" />

                    <include
                        android:id="@+id/row_website"
                        layout="@layout/view_info_row" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <Button
                android:id="@+id/button_enquiry"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_small_plus"
                android:text="@string/contact_enquiry_button"
                app:icon="@drawable/ic_edit_note"
                app:iconGravity="textStart" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_large"
                android:text="@string/contact_social_title"
                android:textAppearance="?attr/textAppearanceTitleMedium" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_small"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/social_facebook"
                    style="@style/Widget.GMIPathway.Button.Social"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:contentDescription="@string/social_facebook"
                    app:icon="@drawable/ic_social_facebook" />

                <Button
                    android:id="@+id/social_instagram"
                    style="@style/Widget.GMIPathway.Button.Social"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_small"
                    android:layout_weight="1"
                    android:contentDescription="@string/social_instagram"
                    app:icon="@drawable/ic_social_instagram" />

                <Button
                    android:id="@+id/social_x"
                    style="@style/Widget.GMIPathway.Button.Social"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_small"
                    android:layout_weight="1"
                    android:contentDescription="@string/social_x"
                    app:icon="@drawable/ic_social_x" />

                <Button
                    android:id="@+id/social_youtube"
                    style="@style/Widget.GMIPathway.Button.Social"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_small"
                    android:layout_weight="1"
                    android:contentDescription="@string/social_youtube"
                    app:icon="@drawable/ic_social_youtube" />

                <Button
                    android:id="@+id/social_tiktok"
                    style="@style/Widget.GMIPathway.Button.Social"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_small"
                    android:layout_weight="1"
                    android:contentDescription="@string/social_tiktok"
                    app:icon="@drawable/ic_social_tiktok" />

                <Button
                    android:id="@+id/social_linkedin"
                    style="@style/Widget.GMIPathway.Button.Social"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_small"
                    android:layout_weight="1"
                    android:contentDescription="@string/social_linkedin"
                    app:icon="@drawable/ic_social_linkedin" />

            </LinearLayout>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</LinearLayout>
