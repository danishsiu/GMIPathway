<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".ui.enquiry.AboutUsActivity">

    <include layout="@layout/view_app_bar" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/about_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_home_header"
                android:paddingHorizontal="@dimen/screen_padding"
                android:paddingVertical="@dimen/spacing_medium">

                <ImageView
                    android:id="@+id/about_logo"
                    android:layout_width="@dimen/about_banner_logo_size"
                    android:layout_height="@dimen/about_banner_logo_size"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_app_emblem"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/about_name"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_small_plus"
                    android:text="@string/institute_name"
                    android:textAppearance="?attr/textAppearanceHeadlineSmall"
                    android:textColor="@color/on_app_bar"
                    app:layout_constraintBottom_toTopOf="@id/about_subtitle"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@id/about_logo"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintVertical_chainStyle="packed" />

                <TextView
                    android:id="@+id/about_subtitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_small_plus"
                    android:layout_marginTop="@dimen/spacing_xsmall"
                    android:text="@string/about_banner_subtitle"
                    android:textAppearance="?attr/textAppearanceBodyMedium"
                    android:textColor="@color/on_app_bar_muted"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@id/about_logo"
                    app:layout_constraintTop_toBottomOf="@id/about_name" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <LinearLayout
                android:id="@+id/section_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/screen_padding" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</LinearLayout>
