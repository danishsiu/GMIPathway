<?xml version="1.0" encoding="utf-8"?>
<!-- One step of a study pathway: a numbered circle joined to the next step by a line,
     then the step's title and what it involves. -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <View
        android:id="@+id/step_line"
        android:layout_width="@dimen/pathway_line_width"
        android:layout_height="0dp"
        android:background="?attr/colorOutlineVariant"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@id/step_number"
        app:layout_constraintStart_toStartOf="@id/step_number"
        app:layout_constraintTop_toBottomOf="@id/step_number" />

    <TextView
        android:id="@+id/step_number"
        android:layout_width="@dimen/pathway_circle"
        android:layout_height="@dimen/pathway_circle"
        android:background="@drawable/bg_pathway_circle"
        android:gravity="center"
        android:importantForAccessibility="no"
        android:textAppearance="?attr/textAppearanceLabelLarge"
        android:textColor="?attr/colorOnPrimary"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/step_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/spacing_small_plus"
        android:minHeight="@dimen/pathway_circle"
        android:gravity="center_vertical"
        android:textAppearance="?attr/textAppearanceTitleSmall"
        android:textColor="?attr/colorPrimary"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/step_number"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/step_body"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/spacing_small_plus"
        android:paddingBottom="@dimen/spacing_medium"
        android:textAppearance="?attr/textAppearanceBodyLarge"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/step_number"
        app:layout_constraintTop_toBottomOf="@id/step_title" />

</androidx.constraintlayout.widget.ConstraintLayout>
