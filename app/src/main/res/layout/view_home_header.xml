<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="@dimen/spacing_small"
    android:paddingTop="@dimen/spacing_small"
    android:paddingBottom="@dimen/home_header_bottom_padding">

    <ImageView
        android:id="@+id/home_logo"
        android:layout_width="@dimen/home_header_logo_size"
        android:layout_height="@dimen/home_header_logo_size"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_app_emblem"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/home_welcome"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/home_welcome"
        android:textAppearance="?attr/textAppearanceBodyMedium"
        android:textColor="@color/on_app_bar_muted"
        app:layout_constraintBottom_toTopOf="@id/home_title"
        app:layout_constraintEnd_toStartOf="@id/button_settings"
        app:layout_constraintStart_toEndOf="@id/home_logo"
        app:layout_constraintTop_toTopOf="@id/home_logo"
        app:layout_constraintVertical_chainStyle="packed" />

    <TextView
        android:id="@+id/home_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/app_name"
        android:textAppearance="?attr/textAppearanceHeadlineLarge"
        android:textColor="@color/on_app_bar"
        app:layout_constraintBottom_toBottomOf="@id/home_logo"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/home_logo"
        app:layout_constraintTop_toBottomOf="@id/home_welcome" />

    <ImageButton
        android:id="@+id/button_settings"
        android:layout_width="@dimen/min_touch_target"
        android:layout_height="@dimen/min_touch_target"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/settings_title"
        android:src="@drawable/ic_settings"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="@color/on_app_bar" />

    <View
        android:id="@+id/home_accent"
        android:layout_width="@dimen/accent_rule_width"
        android:layout_height="@dimen/accent_rule_height"
        android:layout_marginStart="@dimen/spacing_small"
        android:layout_marginTop="@dimen/spacing_small_plus"
        android:background="@drawable/bg_accent_rule"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/home_logo" />

    <TextView
        android:id="@+id/home_tagline"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/spacing_small"
        android:layout_marginTop="@dimen/spacing_small_plus"
        android:text="@string/home_tagline"
        android:textAppearance="?attr/textAppearanceBodyMedium"
        android:textColor="@color/on_app_bar_muted"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/home_accent" />

</androidx.constraintlayout.widget.ConstraintLayout>
