<?xml version="1.0" encoding="utf-8"?>
<!-- Photos sit on black, the usual backdrop for a gallery, so their colours read true. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/photo_backdrop"
    android:orientation="vertical"
    tools:context=".ui.campus.PhotoViewerActivity">

    <include layout="@layout/view_app_bar" />

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/photo_pager"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="@dimen/screen_padding">

        <TextView
            android:id="@+id/photo_caption"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:accessibilityLiveRegion="polite"
            android:textAppearance="?attr/textAppearanceBodyLarge"
            android:textColor="@color/on_app_bar" />

        <TextView
            android:id="@+id/photo_counter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_small"
            android:textAppearance="?attr/textAppearanceLabelLarge"
            android:textColor="@color/on_app_bar_muted" />

    </LinearLayout>

</LinearLayout>
