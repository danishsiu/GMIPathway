<resources>
    <!-- Base application theme. Light and dark mode share it; the colours change in values-night. -->
    <style name="Base.Theme.GMIPathway" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/md_primary</item>
        <item name="colorOnPrimary">@color/md_on_primary</item>
        <item name="colorPrimaryContainer">@color/md_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/md_on_primary_container</item>
        <item name="colorSecondary">@color/md_secondary</item>
        <item name="colorOnSecondary">@color/md_on_secondary</item>
        <item name="colorSecondaryContainer">@color/md_secondary_container</item>
        <item name="colorOnSecondaryContainer">@color/md_on_secondary_container</item>
        <item name="colorError">@color/md_error</item>
        <item name="colorOnError">@color/md_on_error</item>
        <item name="colorErrorContainer">@color/md_error_container</item>
        <item name="colorOnErrorContainer">@color/md_on_error_container</item>
        <item name="colorTertiary">@color/md_tertiary</item>
        <item name="colorOnTertiary">@color/md_on_tertiary</item>
        <item name="colorTertiaryContainer">@color/md_tertiary_container</item>
        <item name="colorOnTertiaryContainer">@color/md_on_tertiary_container</item>
        <item name="android:colorBackground">@color/md_surface</item>
        <item name="colorOnBackground">@color/md_on_surface</item>
        <item name="colorSurface">@color/md_surface</item>
        <item name="colorOnSurface">@color/md_on_surface</item>
        <item name="colorSurfaceVariant">@color/md_surface_variant</item>
        <item name="colorOnSurfaceVariant">@color/md_on_surface_variant</item>
        <item name="colorOutline">@color/md_outline</item>
        <item name="colorOutlineVariant">@color/md_outline_variant</item>
        <item name="colorSurfaceContainerLowest">@color/md_surface_container_lowest</item>
        <item name="colorSurfaceContainerLow">@color/md_surface_container_low</item>
        <item name="colorSurfaceContainer">@color/md_surface_container</item>
        <item name="colorSurfaceContainerHigh">@color/md_surface_container_high</item>
        <item name="colorSurfaceContainerHighest">@color/md_surface_container_highest</item>
        <item name="colorSurfaceDim">@color/md_surface_dim</item>
        <item name="colorSurfaceBright">@color/md_surface_bright</item>
        <item name="android:windowAnimationStyle">@style/Animation.GMIPathway.Activity</item>
        <!-- The font is set in each text style, because a theme-wide font overrides their weights. -->
        <item name="textAppearanceHeadlineLarge">@style/TextAppearance.GMIPathway.HeadlineLarge</item>
        <item name="textAppearanceHeadlineMedium">@style/TextAppearance.GMIPathway.HeadlineMedium</item>
        <item name="textAppearanceHeadlineSmall">@style/TextAppearance.GMIPathway.HeadlineSmall</item>
        <item name="textAppearanceTitleLarge">@style/TextAppearance.GMIPathway.TitleLarge</item>
        <item name="textAppearanceTitleMedium">@style/TextAppearance.GMIPathway.TitleMedium</item>
        <item name="textAppearanceTitleSmall">@style/TextAppearance.GMIPathway.TitleSmall</item>
        <item name="textAppearanceBodyLarge">@style/TextAppearance.GMIPathway.BodyLarge</item>
        <item name="textAppearanceBodyMedium">@style/TextAppearance.GMIPathway.BodyMedium</item>
        <item name="textAppearanceBodySmall">@style/TextAppearance.GMIPathway.BodySmall</item>
        <item name="textAppearanceLabelLarge">@style/TextAppearance.GMIPathway.LabelLarge</item>
        <item name="textAppearanceLabelMedium">@style/TextAppearance.GMIPathway.LabelMedium</item>
        <item name="textAppearanceLabelSmall">@style/TextAppearance.GMIPathway.LabelSmall</item>
        <item name="materialButtonStyle">@style/Widget.GMIPathway.Button.Primary</item>
        <item name="materialButtonOutlinedStyle">@style/Widget.GMIPathway.Button.Secondary</item>
        <item name="borderlessButtonStyle">@style/Widget.GMIPathway.Button.Text</item>
        <item name="materialCardViewStyle">@style/Widget.GMIPathway.Card.Standard</item>
        <item name="textInputStyle">@style/Widget.GMIPathway.TextInput</item>
        <item name="textInputOutlinedExposedDropdownMenuStyle">@style/Widget.GMIPathway.Select</item>
        <item name="tabStyle">@style/Widget.GMIPathway.Tabs</item>
        <item name="toolbarStyle">@style/Widget.GMIPathway.AppBar</item>
    </style>

    <style name="Theme.GMIPathway" parent="Base.Theme.GMIPathway" />

    <!-- System splash shown first; Android 12 and later use it natively, older versions through the compat library. -->
    <style name="Theme.GMIPathway.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/app_bar_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_app_emblem</item>
        <item name="postSplashScreenTheme">@style/Theme.GMIPathway</item>
    </style>

    <!-- Every screen change uses the same short slide and fade. -->
    <style name="Animation.GMIPathway.Activity" parent="@android:style/Animation.Activity">
        <item name="android:activityOpenEnterAnimation">@anim/screen_open_enter</item>
        <item name="android:activityOpenExitAnimation">@anim/screen_open_exit</item>
        <item name="android:activityCloseEnterAnimation">@anim/screen_close_enter</item>
        <item name="android:activityCloseExitAnimation">@anim/screen_close_exit</item>
    </style>

    <!-- Keeps the search box and its icons readable on the blue toolbar in light and dark mode. -->
    <style name="ThemeOverlay.GMIPathway.Toolbar" parent="">
        <item name="colorControlNormal">@color/on_app_bar</item>
        <item name="colorControlActivated">@color/on_app_bar</item>
        <item name="colorOnSurfaceVariant">@color/on_app_bar</item>
        <item name="android:textColorPrimary">@color/on_app_bar</item>
        <item name="android:textColorHint">@color/on_app_bar_muted</item>
    </style>

</resources>
