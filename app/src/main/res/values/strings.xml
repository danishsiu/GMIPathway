    <!-- About Us. Source: research/gmi_research.md, section 1 -->
    <string name="about_title">About Us</string>
    <string name="about_banner_subtitle">Kajang, Selangor. Established in 1991.</string>
    <string name="about_section_who">Who we are</string>
    <string name="about_who_body">The German-Malaysian Institute (GMI) is a technical education institute on a 75-acre campus in Kajang, Selangor. It began as a joint venture between the Governments of Malaysia and Germany, and describes itself as a pioneer of German-style technical and vocational education and training (TVET) in Malaysia.</string>
    <string name="about_section_history">Our history</string>
    <string name="about_history_1991">1991: GMI was established.</string>
    <string name="about_history_1992">1992: The first students enrolled, and Tun Dr Mahathir Mohamad led the grand opening.</string>
    <string name="about_history_2001">2001: The German University Preparatory Programme (GAPP) was launched.</string>
    <string name="about_history_2008">2008: GMI moved to its campus in Kajang.</string>
    <string name="about_history_2024">2024: GMI reported Ministry of Higher Education approval to upgrade to GMI University College of Applied Sciences.</string>
    <string name="about_section_vision">Vision</string>
    <string name="about_vision_body" translatable="false">To be an internationally competitive higher learning institution delivering advanced technical education, training and services; empowering a skilled workforce to reach its fullest potential.</string>
    <string name="about_section_mission">Mission</string>
    <string name="about_mission_body" translatable="false">To provide cutting-edge industrial solutions in advanced technical education and training through innovative blended methodologies, fostering lifelong learning and responsive to global industry demands.</string>
    <string name="about_section_german">German-based education</string>
    <string name="about_german_practical" formatted="false">A learning approach of 70% practical and 30% theory</string>
    <string name="about_german_centres">22 Advanced Technology Centres, many linked to industry names</string>
    <string name="about_german_language">German language in the diploma curriculum</string>
    <string name="about_german_industry">An Industry Advisory Council of industry partners</string>
    <string name="about_section_governance">Governance</string>
    <string name="about_governance_body">GMI is a Company Limited by Guarantee founded by Majlis Amanah Rakyat (MARA) and the Malaysian-German Chamber of Commerce and Industry (MGCC). Its implementing agencies are MARA and GIZ GmbH, and a 10-member Board of Directors governs the institute.</string>
    <string name="about_section_accreditation">Accreditation</string>
    <string name="about_accreditation_body">GMI\'s programmes are listed on the Malaysian Qualifications Register. Most diplomas follow Board of Engineers Malaysia or Malaysia Board of Technologists standards. GMI is also a Cambridge examination centre and a TELC certified examination centre.</string>
</resources>
