    <!-- About Us -->
    <string name="about_title">Tentang Kami</string>
    <string name="about_banner_subtitle">Kajang, Selangor. Ditubuhkan pada 1991.</string>
    <string name="about_section_who">Siapa kami</string>
    <string name="about_who_body">German-Malaysian Institute (GMI) ialah institut pendidikan teknikal di kampus seluas 75 ekar di Kajang, Selangor. Ia bermula sebagai usaha sama antara Kerajaan Malaysia dan Jerman, dan menggambarkan dirinya sebagai perintis pendidikan dan latihan teknikal dan vokasional (TVET) gaya Jerman di Malaysia.</string>
    <string name="about_section_history">Sejarah kami</string>
    <string name="about_history_1991">1991: GMI ditubuhkan.</string>
    <string name="about_history_1992">1992: Pelajar pertama mendaftar, dan Tun Dr Mahathir Mohamad merasmikan pembukaan utama.</string>
    <string name="about_history_2001">2001: German University Preparatory Programme (GAPP) dilancarkan.</string>
    <string name="about_history_2008">2008: GMI berpindah ke kampusnya di Kajang.</string>
    <string name="about_history_2024">2024: GMI melaporkan kelulusan Kementerian Pendidikan Tinggi untuk dinaik taraf kepada GMI University College of Applied Sciences.</string>
    <string name="about_section_vision">Visi</string>
    <string name="about_section_mission">Misi</string>
    <string name="about_section_german">Pendidikan berasaskan Jerman</string>
    <string name="about_german_practical" formatted="false">Pendekatan pembelajaran 70% amali dan 30% teori</string>
    <string name="about_german_centres">22 Pusat Teknologi Termaju, kebanyakannya berkait dengan nama industri</string>
    <string name="about_german_language">Bahasa Jerman dalam kurikulum diploma</string>
    <string name="about_german_industry">Majlis Penasihat Industri yang dianggotai rakan industri</string>
    <string name="about_section_governance">Tadbir urus</string>
    <string name="about_governance_body">GMI ialah Syarikat Berhad Menurut Jaminan yang diasaskan oleh Majlis Amanah Rakyat (MARA) dan Malaysian-German Chamber of Commerce and Industry (MGCC). Agensi pelaksananya ialah MARA dan GIZ GmbH, dan Lembaga Pengarah seramai 10 ahli mentadbir institut ini.</string>
    <string name="about_section_accreditation">Akreditasi</string>
    <string name="about_accreditation_body">Program GMI disenaraikan dalam Daftar Kelayakan Malaysia. Kebanyakan diploma mengikut standard Lembaga Jurutera Malaysia atau Lembaga Teknologis Malaysia. GMI juga merupakan pusat peperiksaan Cambridge dan pusat peperiksaan bertauliah TELC.</string>
