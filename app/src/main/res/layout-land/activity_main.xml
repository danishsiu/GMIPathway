<?xml version="1.0" encoding="utf-8"?>
<!-- Landscape puts the welcome panel beside the menu, so the menu fits without much scrolling. -->
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false"
    tools:context=".ui.home.MainActivity">

    <!-- The status bar icons are light, so this strip keeps them readable across the whole width. -->
    <FrameLayout
        android:id="@+id/home_status_strip"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/app_bar_background" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/home_status_strip"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <FrameLayout
            android:id="@+id/home_panel"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="2"
            android:background="@drawable/bg_home_panel">

            <!-- The photo and tint fill the whole panel, behind the cutout and navigation bar.
                 Only the content inside is padded clear of them. -->
            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="no"
                android:scaleType="centerCrop"
                android:src="@drawable/campus_hero" />

            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_home_panel_tint" />

            <FrameLayout
                android:id="@+id/home_panel_content"
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <include layout="@layout/view_home_header" />

            </FrameLayout>

        </FrameLayout>

        <androidx.core.widget.NestedScrollView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="3">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="@dimen/spacing_medium">

                <include layout="@layout/view_home_menu" />

            </FrameLayout>

        </androidx.core.widget.NestedScrollView>

    </LinearLayout>

</RelativeLayout>
